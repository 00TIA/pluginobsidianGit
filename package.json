{
	"name": "mercurio-git-sync",
	"version": "1.0.1",
	"description": "Obsidian desktop plugin: commit, pull, push and sync the vault with git (via simple-git).",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --import tsx --test \"test/**/*.test.ts\""
	},
	"keywords": [
		"obsidian",
		"git"
	],
	"license": "0-BSD",
	"dependencies": {
		"simple-git": "^4.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.20.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
